{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "next/server": ["./server/shims/next-server.ts"],
      "next/headers": ["./server/shims/next-headers.ts"],
      "next/cache": ["./server/shims/next-cache.ts"]
    }
  },
  "include": ["./**/*.ts", "../server/api-router.ts", "../server/shims/**/*.ts"],
  "exclude": ["../node_modules", "../.next", "../server/api/**"]
}
